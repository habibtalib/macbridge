# Copy to .env and fill in. Never commit .env.

# Required. Every Mac must present this to use the server.
#   openssl rand -base64 32
ACCESS_TOKEN=

# Shared between the signaling server and coturn.
#   openssl rand -hex 32
TURN_SECRET=

# Public hostname and IPv4 address of this server.
TURN_HOST=turn.example.com
PUBLIC_IP=203.0.113.10

# What the Macs are told to use. Keep the host in step with TURN_HOST.
STUN_URLS=stun:turn.example.com:3478
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp

# Optional limits. Empty means the default given in brackets.
# Messages one connection may send per second [50], and in one burst [100]. Over that it is closed.
RATE_LIMIT_PER_SECOND=
RATE_LIMIT_BURST=
# A device that reads too slowly is dropped once this many bytes wait to be sent to it [1048576, 1 MB].
MAX_BUFFERED_BYTES=
# Connections in total [1000], and from one address [20].
MAX_CONNECTIONS=
MAX_CONNECTIONS_PER_IP=
# 1: count connections by the client address in X-Forwarded-For. Set it only when the server
# is reachable through your reverse proxy alone, and the proxy sets or appends that header.
# docker-compose.yml uses 1 unless this says 0.
TRUST_PROXY=
# How many proxies append to X-Forwarded-For [1]: the client is that many entries from the end.
TRUST_PROXY_HOPS=
